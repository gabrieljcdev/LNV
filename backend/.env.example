# Copy to .env and fill in. .env is never committed.
PORT=3001
DISCOGS_TOKEN=
YOUTUBE_API_KEY=

# Where the site and API live — used to build the link in confirmation emails.
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3001/api

# Email for account confirmation. Leave SMTP_HOST empty in local dev: the
# confirmation link is then printed in the backend console and shown on the
# sign-up page instead of being emailed. Any SMTP provider works (Resend,
# Postmark, Mailgun, SendGrid, Gmail with an app password…).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Late Night Vibes <no-reply@yourdomain.com>"
