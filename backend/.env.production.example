# The server's backend/.env (HOSTING.md step 7). Copy your API keys across from your PC's .env — never paste them into chat.
NODE_ENV=production
PORT=3001
LNV_DB_PATH=/var/lib/lnv/vinyl_crate.db
FRONTEND_URL=https://waxopathy.com
API_URL=https://waxopathy.com/api

DISCOGS_TOKEN=
YOUTUBE_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=
LASTFM_SHARED_SECRET=

# Until an email provider is chosen, leave SMTP empty — but then NOBODY can confirm a sign-up (the dev shortcut
# that shows the confirmation link is switched off in production). Give your own account a password with
# set-password.mjs; open sign-ups only after mail works.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
