# /etc/caddy/Caddyfile. Caddy fetches and renews the HTTPS certificates itself, but only once the name's DNS points at this server (the A records), so
# apply this file AFTER the DNS answers (claude/2026-10-23-domain-and-email.md). 23 Oct 2026: the site is chewingtheceiling.com; the .co.uk, www and the
# old waxopathy.com names all send people there.
www.chewingtheceiling.com, chewingtheceiling.co.uk, www.chewingtheceiling.co.uk, waxopathy.com, www.waxopathy.com {
	redir https://chewingtheceiling.com{uri} permanent
}

chewingtheceiling.com {
	encode zstd gzip

	# The API (and nothing else) goes to the backend.
	handle /api/* {
		reverse_proxy 127.0.0.1:3001
	}

	# Everything else is the built site; unknown paths fall back to index.html (it is a single-page app).
	handle {
		root * /opt/lnv/frontend/dist
		try_files {path} /index.html
		file_server
	}

	# Built files have hashed names, so they can be cached for good; the page itself must not be.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@page path / /index.html
	header @page Cache-Control "no-cache"

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
